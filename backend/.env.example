# CodeRev AI — Backend Environment Variables
# Copy this file to .env and fill in the paths before running.

# Paths to trained model weight files (.pt)
# These are created after running the training pipeline.
CONTRIBUTOR_MODEL_PATH=models/weights/single_encoder.pt
REVIEWER_MODEL_PATH=models/weights/dual_encoder.pt

# Uvicorn server settings (optional overrides)
HOST=0.0.0.0
PORT=8000
